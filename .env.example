# ===========================================
# Task Management App — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Firebase Admin SDK (Backend) ---
# Option A: Path to service account JSON file
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Inline credentials (use if deploying to Railway/Render)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=your-client-email@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Firebase Client SDK (Frontend) ---
# These are public config values (safe to commit, but kept here for reference)
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx

# --- Google Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key

# --- Frontend URL (for CORS) ---
FRONTEND_URL=http://localhost:5173
